        <mxCell id="yU9l7hP_QC29vx_HUS9G-86" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font color=&quot;#4ec9b0&quot;&gt;Image Class&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Responsible for handling fundemental image processing algorihms such as blurring,edge detection and thresholding etc.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
