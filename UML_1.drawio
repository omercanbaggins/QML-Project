        <mxCell id="yU9l7hP_QC29vx_HUS9G-87" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font color=&quot;#4ec9b0&quot;&gt;QQuickImage Provider Class&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;Built-in pyside 6 class which is used for QML images and provides communication between them&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="280" y="424" width="240" height="160" as="geometry" />
